BACKEND_MODE=real
# To use mock APIs for testing, change to: BACKEND_MODE=mock

# OpenRouter API for LLM (OpenAI-compatible endpoint)
OPENROUTER_API_KEY='your-openrouter-api-key-here'
OPENROUTER_BASE_URL='https://openrouter.ai/api/v1'

# LLM Model configuration (OpenRouter model IDs)
# See https://openrouter.ai/models for available models
LLM_MODEL=openai/gpt-4o-mini
LLM_MAX_OUTPUT_TOKENS=600

# Deepgram API for Speech-to-Text
DEEPGRAM_API_KEY='your-deepgram-api-key-here'

# Rime TTS API for speech synthesis
RIME_API_KEY='your-rime-api-key-here'

# Rime TTS configuration
RIME_SPEAKER=celeste
RIME_MODEL_ID=coda
RIME_AUDIO_FORMAT=audio/wav

# LiveKit configuration (for future sessions)
LIVEKIT_URL='wss://your-livekit-url'
LIVEKIT_API_KEY='your-livekit-api-key'
LIVEKIT_API_SECRET='your-livekit-api-secret'
